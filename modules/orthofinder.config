process {
    withLabel: 'orthofinder' {
        stageInMode = 'copy'
        container = 'quay.io/biocontainers/orthofinder:3.2--hdfd78af_0'
        cpus = 20
        memory = '120 GB'  
    }
}

process {
    withLabel: 'cluster_OG' {
        stageInMode = 'copy'
        container = 'quay.io/biocontainers/mmseqs2:18.8cc5c--hd6d6fdc_0'
        cpus = 8
        memory = '40 GB'  
    }
}